# CoachLenz backend env. Mirrors backend/config.py Settings — keep in sync.
# Only DATABASE_URL and SECRET_KEY are required; everything else has a default.

# ── Required ──
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
SECRET_KEY=your-256-bit-secret-key-here
# Previous secret during a key rotation (still validates old tokens); empty otherwise.
SECRET_KEY_PREVIOUS=

# ── Auth / tokens ──
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database pool (Postgres only; values are per process) ──
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Cloudflare R2 (film storage) ──
# If R2_* are unset, uploads route to ephemeral /tmp and ALL FILM IS LOST on redeploy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=coachlenz-film
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_PRESIGNED_EXPIRY_SECONDS=86400

# ── Anthropic (detection + reports) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Stripe (billing). The code reads exactly these three price IDs. ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COACH=
STRIPE_PRICE_ATHLETIC_DEPT=
STRIPE_PRICE_DISTRICT=

# ── Email (Resend) ──
RESEND_API_KEY=
RESEND_DOMAIN=cosbyaisolutions.com
EMAIL_FROM=CoachLenz <noreply@cosbyaisolutions.com>
ADMIN_EMAIL=info@cosbyaisolutions.com
# Optional reply-to for the founder welcome email (defaults to jay@coachlenz.com in code).
FOUNDER_REPLY_TO=

# ── SMS verification (Twilio; optional — onboarding skips the phone step if unset) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# ── Encryption (Fernet) ──
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Previous Fernet keys during rotation (comma-separated); empty otherwise.
FERNET_KEYS_PREVIOUS=

# ── Admin ──
# Comma-separated emails granted admin access (e.g. aiwithjaycoz@gmail.com).
ADMIN_EMAILS=
# Super-admin seed password: set a strong 12+ char value. Seeding refuses if empty/weak.
ADMIN_PASSWORD=

# ── Observability (set on the WORKER services too, or workers report nothing) ──
SENTRY_DSN=

# ── App / limits ──
APP_URL=https://coachlenz.com
ENVIRONMENT=production
WORKERS_IN_API=all            # all | light | none (worker/HTTP process split)
MAX_UPLOAD_BYTES=21474836480  # 20GB
TRIAL_DAYS=14
TRIAL_GAME_LIMIT=1
DEFAULT_MONTHLY_ANALYSIS_LIMIT=300
RLS_ENABLED=false

# ── Ingest levers (optional; read directly from env by worker_ingest, not config.py) ──
# HD unlock: paste exported Netscape cookies.txt contents to defeat the datacenter
# throttle (public YouTube / private Hudl / NFHS). YTDLP_PROXY routes downloads +
# the headless capture through a residential IP.
YOUTUBE_COOKIES=
HUDL_COOKIES=
NFHS_COOKIES=
YTDLP_PROXY=
